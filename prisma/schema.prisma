generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id               String             @id @default(uuid())
  clerkUserId      String             @unique
  email            String             @unique
  name             String?
  imageUrl         String?
  phone            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  role             UserRole           @default(USER)
  permissions      Json?              // For storing editor permissions
  TestDriveBooking TestDriveBooking[]
  UserSavedCar     UserSavedCar[]
  articles         Article[]
}

model Car {
  id                String             @id @default(uuid())
  make              String
  model             String
  year              Int
  price             Decimal            @db.Decimal(10, 2)
  mileage           Int
  color             String
  fuelType          String
  transmission      String
  bodyType          String
  isLuxury          Boolean            @default(false)
  isEconomic        Boolean            @default(false)
  isCommercial      Boolean            @default(false)
  insuranceSegment  String?            // A–G for finance/insurance lookup
  driveType         String?
  seats             Int?
  description       String
  category          String?
  videoUrl          String?
  status            CarStatus          @default(AVAILABLE)
  featured          Boolean            @default(false)
  testDriveAvailable Boolean            @default(true)
  
  images            String[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  testDriveBookings TestDriveBooking[]
  savedBy           UserSavedCar[]
  loanRequests      LoanRequest[]

  @@index([make, model])
  @@index([bodyType])
  @@index([price])
  @@index([year])
  @@index([status])
  @@index([fuelType])
  @@index([featured])
  @@index([isEconomic])
  @@index([isCommercial])
}

model DealershipInfo {
  id           String        @id @default(uuid())
  name         String        @default("Click Car Motors")
  address      String        @default("69 Car Street, Autoville, CA 69420")
  phone        String        @default("+1 (555) 123-4567")
  email        String        @default("contact@clickcar.com")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  workingHours WorkingHour[]
}

model WorkingHour {
  id           String         @id @default(uuid())
  dealershipId String
  dayOfWeek    DayOfWeek
  openTime     String
  closeTime    String
  isOpen       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  dealership   DealershipInfo @relation(fields: [dealershipId], references: [id], onDelete: Cascade)

  @@unique([dealershipId, dayOfWeek])
  @@index([dealershipId])
  @@index([dayOfWeek])
  @@index([isOpen])
}

model UserSavedCar {
  id      String   @id @default(uuid())
  userId  String
  carId   String
  savedAt DateTime @default(now())
  car     Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, carId])
  @@index([userId])
  @@index([carId])
}

model TestDriveBooking {
  id          String        @id @default(uuid())
  carId       String
  userId      String
  bookingDate DateTime      @db.Date
  startTime   String
  endTime     String
  status      BookingStatus @default(PENDING)
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  car         Car           @relation(fields: [carId], references: [id])
  user        User          @relation(fields: [userId], references: [id])

  @@index([carId])
  @@index([userId])
  @@index([bookingDate])
  @@index([status])
}

model ChatLog {
  id               String   @id @default(uuid())
  userId           String?  // Optional - for tracking authenticated users
  sessionId        String   // For tracking anonymous users
  userMessage      String   @db.Text
  correctedMessage String?  @db.Text // Spelling-corrected version of user message (if different)
  aiResponse       String   @db.Text
  carsFound        Int      @default(0)
  carsShown        Int      @default(0)
  carIds           String[] // Array of car IDs that were shown
  language         String   @default("ar") // ar for Arabic, en for English
  createdAt        DateTime @default(now())
  
  @@index([userId])
  @@index([sessionId])
  @@index([createdAt])
  @@index([language])
}

/** Full chatbot conversations (resumable history + loan intake state). */
model ChatConversation {
  id          String        @id @default(uuid())
  sessionId   String
  clerkUserId String?
  title       String?
  mode        String        @default("idle") // idle | car_select | loan_intake | offers | contact_intake | submitted
  loanState   Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  messages    ChatMessage[]

  @@index([sessionId])
  @@index([clerkUserId])
  @@index([updatedAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user | assistant | system
  content        String           @db.Text
  payload        Json? // { cars, offers, fieldPrompt, loanSubmitted, ... }
  createdAt      DateTime         @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model FeaturedBrand {
  id        String   @id @default(uuid())
  name      String   // Brand name in English
  nameAr    String   // Brand name in Arabic
  image     String   // Image URL
  order     Int      @default(0) // Display order
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

model FeaturedModel {
  id        String   @id @default(uuid())
  name      String   // Model name in English
  nameAr    String   // Model name in Arabic
  image     String   // Image URL
  order     Int      @default(0) // Display order
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([order])
  @@index([isActive])
}

enum UserRole {
  USER
  ADMIN
  EDITOR
}

enum CarStatus {
  AVAILABLE
  UNAVAILABLE
  SOLD
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Bank {
  id                    String   @id @default(uuid())
  name                  String
  logoImage             String
  interestRate          Decimal  @db.Decimal(5, 2) // profit margin % (fallback / legacy)
  sectorInterestRates   Json?    // { "خاص": 5.5, "حكومي مدني": 4.5, ... }
  defaultBalloonPaymentPct Decimal? @db.Decimal(5, 2) // الدفعة الآخيرة %
  loanPolicy            String?
  adminFeesCap          Decimal? @db.Decimal(10, 2)
  defaultAdminFeesPct   Decimal? @db.Decimal(5, 4) // e.g. 0.01 = 1%
  minInsurancePremium   Decimal? @db.Decimal(10, 2)
  assetDepreciationRate Decimal? @db.Decimal(5, 4) // e.g. 0.15 = 15%/year
  ftpAnchors            Json?    // annual FTP anchor rates
  cor                   Decimal? @db.Decimal(6, 4) // cost of risk
  opex                  Decimal? @db.Decimal(6, 4)
  irrTarget             Decimal? @db.Decimal(6, 4)
  brandSegmentMap       Json?    // car brand -> segment A–G
  insuranceTable        Json?    // gender x age x segment rates
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  loanRequests          LoanRequest[]
}

model Article {
  id             String           @id @default(uuid())
  title          String
  slug           String           @unique
  content        String           @db.Text // Keep for backward compatibility
  contentSections Json?           // New field for rich content
  excerpt        String?
  authorId       String?
  author         User?            @relation(fields: [authorId], references: [id])
  published      Boolean          @default(false)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  image          String?
  tags           String[]

  @@index([slug])
  @@index([published])
  @@index([publishedAt])
  @@index([authorId])
}

model Review {
  id         String   @id @default(uuid())
  clientName String
  city       String
  car        String
  rating     Int      // Rating from 1 to 5
  videoUrl   String?
  imageUrl   String?
  reviewText String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([rating])
  @@index([createdAt])
}

model Contact {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
}

model LoanRequest {
  id                      String           @id @default(uuid())
  carId                   String
  car                     Car              @relation(fields: [carId], references: [id], onDelete: Cascade)

  // Personal Information
  fullName                String
  email                   String
  mobileNumber            String
  city                    String
  time                    String // Preferred contact time

  // ID Information
  idNumber                String
  idImage                 String? // URL/path to uploaded ID image

  // Car Information (from form, may differ from actual car)
  carMake                 String
  carModel                String
  carCategory             String?
  carYear                 Int

  // Birth Information
  birthDateType           String   @default("hijri") // "hijri" or "gregorian"
  birthMonth              String // month (1-12)
  birthYear               String

  // Gender
  gender                  String // "male" or "female"

  // Loan Details
  loanAmount              Decimal          @db.Decimal(12, 2)
  downPayment             Decimal          @db.Decimal(12, 2)
  loanTerm                Int // in years
  termMonths              Int?
  downPaymentPct          Decimal?         @db.Decimal(5, 2)
  monthlyPayment          Decimal?         @db.Decimal(12, 2)
  baseInstallment         Decimal?         @db.Decimal(12, 2)
  monthlyInsurance        Decimal?         @db.Decimal(12, 2)
  interestRate            Decimal?         @db.Decimal(5, 2)
  finalPayment            Decimal?         @db.Decimal(12, 2) // last month cashflow
  balloonPayment          Decimal?         @db.Decimal(12, 2)
  balloonPaymentPct       Decimal?         @db.Decimal(5, 2)
  adminFees               Decimal?         @db.Decimal(12, 2)
  totalInsurance          Decimal?         @db.Decimal(12, 2)
  totalProfit             Decimal?         @db.Decimal(12, 2)
  totalPayment            Decimal?         @db.Decimal(12, 2) // grand total
  insuranceSegment        String?
  offerSnapshot           Json?

  // Financial Information
  netSalary               Decimal?         @db.Decimal(12, 2)
  employerSector          String? // "خاص", "حكومي مدني", "حكومي عسكرى", "متقاعد"
  employer                String?
  salaryTransferBankId    String?
  salaryTransferBank      Bank?            @relation(fields: [salaryTransferBankId], references: [id])

  // Credit Information
  hasRealEstateFinance    Boolean? // true if has real estate finance
  hasCreditDefault        Boolean? // true if has credit default
  totalMonthlyObligations Decimal?         @db.Decimal(12, 2)

  // Additional Information
  additionalInfo          String?          @db.Text

  // Status and timestamps
  status                  LoanRequestStatus @default(PENDING)
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt

  @@index([carId])
  @@index([email])
  @@index([mobileNumber])
  @@index([status])
  @@index([createdAt])
}

model SocialMedia {
  id        String   @id @default(uuid())
  platform  String   // facebook, instagram, twitter, youtube, tiktok, snapchat, whatsapp, etc
  url       String   // The link/URL for the social media platform
  icon      String?  // Icon name or identifier
  order     Int      @default(0) // Display order
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([platform])
  @@index([platform])
  @@index([isActive])
  @@index([order])
}

model StoreInfo {
  id                   String   @id @default(uuid())
  name                 String   @default("Click Car Motors") // Store name
  description          String?  @db.Text // Store description/about short
  address              String?  // Store location/address
  city                 String?  // City
  country              String?  // Country
  phone                String?  // Main phone number
  whatsapp             String?  // WhatsApp number
  email                String?  // Main email
  latitude             String?  // GPS latitude for maps
  longitude            String?  // GPS longitude for maps
  whatsappEnabled      Boolean  @default(true)  // Show/hide floating WhatsApp button
  whatsappLabel        String?  // Label shown above the floating button
  whatsappText         String?  @db.Text // Pre-filled message text when button is clicked
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([id]) // Only one store info record
}

model Logo {
  id        String   @id @default(uuid())
  imageUrl  String   // Logo image URL/path
  altText   String   @default("Company Logo")
  type      String   @default("main") // main, favicon, etc
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([isActive])
}

model AboutPage {
  id                String         @id @default(uuid())
  title             String         @default("من نحن")
  introText         String         @db.Text
  visionTitle       String         @default("رؤيتنا")
  visionParagraph1  String         @db.Text
  visionParagraph2  String         @db.Text
  visionImage       String?
  visionImageAlt    String?
  missionTitle      String         @default("رسالتنا")
  missionParagraph1 String         @db.Text
  missionParagraph2 String         @db.Text
  missionImage      String?
  missionImageAlt   String?
  whyUsTitle        String         @default("لماذا يختار العملاء ماكس موتورز؟")
  ctaTitle          String         @default("هل أنت مستعد للعثور على سيارتك؟")
  ctaText           String         @db.Text
  isPublished       Boolean        @default(true)
  metaDescription   String?
  metaKeywords      String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  features          AboutFeature[]

  @@unique([id])
}

model AboutFeature {
  id          String    @id @default(uuid())
  aboutPageId String
  title       String
  description String    @db.Text
  icon        String    @default("Target")
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  aboutPage   AboutPage @relation(fields: [aboutPageId], references: [id], onDelete: Cascade)

  @@index([aboutPageId])
  @@index([order])
  @@index([isActive])
}

model HeroSection {
  id             String   @id @default(uuid())
  videoUrl       String   // Hero video URL/path
  title          String   @default("مرحباً بك") // Hero title
  subtitle       String?  // Hero subtitle
  posterImage    String?  // Video poster/thumbnail image
  isActive       Boolean  @default(true)
  autoplay       Boolean  @default(true)
  loop           Boolean  @default(true)
  muted          Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([id]) // Only one hero section
}

model PixelSettings {
  id               String   @id @default(uuid())
  facebookPixel    String?
  googleAnalytics  String?
  googleAdsId      String?
  tiktokPixel      String?
  snapchatPixel    String?
  microsoftClarity String?
  updatedAt        DateTime @updatedAt

  @@unique([id])
}

model Mandeb {
  id        String   @id @default(uuid())
  name      String
  phone     String
  city      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([city])
}
