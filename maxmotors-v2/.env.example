# ---------------------------------------------------------------------------
# Every variable here is validated at boot by src/config/env.ts.
# A missing or malformed value fails fast with a readable message instead of
# surfacing as an undefined at runtime.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database (Supabase Postgres) -----------------------------------------
# Pooled connection (port 6543) used by the app.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true
# Direct connection (port 5432) used by `prisma migrate`.
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# --- Supabase (file storage only; Prisma owns all data access) ------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=car-images

# --- Auth (Clerk) ----------------------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --- AI (optional; chatbot and image analysis degrade gracefully without) --
GEMINI_API_KEY=

# --- Observability ---------------------------------------------------------
LOG_LEVEL=debug
